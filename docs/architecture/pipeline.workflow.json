  "cards": [
    {
      "dot": "cyan",
      "title": "Generation",
      "items": [
        "Analysis can walk a large ICD in chunks, then distill the change spec.",
        "Transform continues up to three times when a file is cut off.",
        "Header documentation is one pass. It does not loop."
      ]
    },
    {
      "dot": "amber",
      "title": "Gates",
      "items": [
        "Verify runs structural checks, one model pass, then one targeted rewrite.",
        "Compile retries a compile-fix agent up to four times, then fills missing members from how the source uses them."
      ]
    },
    {
      "dot": "rose",
      "title": "Sandbox",
      "items": [
        "Agentic debug is the default. It rebuilds: build, triage, root cause, plan, patch, verify, decide.",
        "The if-off links are the fallback order, not extra steps after a successful agentic build. Orchestrator, then legacy.",
        "REMOTE_BUILD_ENABLED replaces this local loop with a remote build."
      ]
    }
  ]
